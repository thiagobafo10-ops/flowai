{
  "name": "flowai",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build -w apps/web",
    "test": "npm run test --workspaces --if-present",
    "test:edge": "node scripts/test-edge.mjs",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "test:instagram:e2e": "node scripts/test-instagram-e2e.mjs",
    "test:ai:e2e": "node scripts/test-ai-e2e.mjs",
    "test:mvp:e2e": "node scripts/test-mvp-e2e.mjs",
    "test:automation:e2e": "node scripts/test-automation-e2e.mjs",
    "test:growth:e2e": "node scripts/test-growth-e2e.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > packages/core/src/db/database.types.ts"
  },
  "devDependencies": {
    "supabase": "2.120.0"
  }
}
